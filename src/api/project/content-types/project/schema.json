      }
    },
    "content_en": {
      "type": "customField",
      "customField": "plugin::ckeditor.CKEditor",
      "options": {
        "output": "HTML",
        "licenseKey": "eyJhbGciOiJFUzI1NiJ9..vFWyo6YSAbLPC3LQze0Q8bkOAyCjlZJbUxDMgRLsDtq1HHXVKD7F68BivGImuzXikROB1m8lsSzBI-_c1J_8mQ",
