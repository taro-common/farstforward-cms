{
  "kind": "collectionType",
  "collectionName": "projects",
  "info": {
    "singularName": "project",
    "pluralName": "projects",
    "displayName": "Project"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "pluginOptions": {
        "content-manager": {
          "visible": false
        }
      }
    },
    "title_th": {
      "type": "string",
      "required": true
    },
    "title_en": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "customField",
      "customField": "plugin::auto-locales-slug.auto-locales-slug",
      "required": true,
      "options": {
        "pattern": "title"
      }
    },
    "tag": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::our-gallery-tag.our-gallery-tag"
    },
    "description_th": {
      "type": "text"
    },
    "description_en": {
      "type": "text"
    },
    "content_th": {
      "type": "customField",
      "customField": "plugin::ckeditor.CKEditor",
      "options": {
        "output": "HTML",
        "preset": "standard",
        "licenseKey": "GPL"
      }
    },
    "content_en": {
      "type": "customField",
      "customField": "plugin::ckeditor.CKEditor",
      "options": {
        "output": "HTML",
        "licenseKey": "GPL",
        "preset": "standard"
      }
    },
    "seo": {
      "type": "component",
      "component": "seo.seo",
      "repeatable": false
    }
  }
}
